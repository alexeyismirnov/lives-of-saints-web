# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saints?schema=public"

# NextAuth (Phase 2 editor)
AUTH_SECRET="dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
# On Railway, prefer: NEXTAUTH_URL=${{RAILWAY_STATIC_URL}}

# Optional: override Hugo content path for import (default: .content-source/lives-of-saints-hugo/content)
# Run `npm run content:fetch` first to clone https://github.com/alexeyismirnov/lives-of-saints-hugo with submodules.
# CONTENT_DIR=".content-source/lives-of-saints-hugo/content"

# Optional: alternate Hugo git remote
# HUGO_SOURCE_REPO="https://github.com/alexeyismirnov/lives-of-saints-hugo.git"
