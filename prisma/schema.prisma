generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  en
  ru
}

enum UserRole {
  editor
  admin
}

model Section {
  id        String       @id @default(cuid())
  slug      String       @unique
  sortOrder Int
  titleEn   String
  titleRu   String
  entries   SaintEntry[]

  @@map("sections")
}

model SaintEntry {
  id             String    @id @default(cuid())
  language       Language
  sectionId      String
  section        Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug           String
  linkTitle      String
  calendarLabel  String    @default("")
  dayOfMonth     Int?
  sortWeight     Int       @default(0)
  bodyMd         String    @db.Text
  audioUrl       String?
  isDraft        Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
  updatedById    String?
  updatedBy      User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([language, sectionId, slug])
  @@index([language, sectionId, dayOfMonth, sortWeight])
  @@map("saint_entries")
}

model SitePage {
  id       String   @id @default(cuid())
  language Language @unique
  bodyMd   String   @db.Text

  @@map("site_pages")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  role         UserRole     @default(editor)
  name         String?
  createdAt    DateTime     @default(now())
  entries      SaintEntry[]
  accounts     Account[]
  sessions     Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EventLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  message   String   @db.Text

  @@index([createdAt(sort: Desc)])
  @@map("event_logs")
}
